rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Профиль: пароль НИКОГДА не должен храниться здесь.
    // Firebase Authentication хранит credential отдельно.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['password']);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['password'])
        && request.resource.data.isModerator == resource.data.isModerator;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Остальные коллекции оставлены совместимыми с текущим приложением.
    // Для production желательно отдельно ограничить права на каждую операцию.
    match /countries/{id} {
      allow read, write: if request.auth != null;
    }

    match /cities/{id} {
      allow read, write: if request.auth != null;
    }

    match /requests/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
